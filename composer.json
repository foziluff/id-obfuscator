{
    "name": "foziluff/id-obfuscator",
    "description": "ID Obfuscation Middleware for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Foziluff\\IdObfuscator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foziluff\\IdObfuscator\\IdObfuscatorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.20",
        "larastan/larastan": "^3.0"
    }
}
